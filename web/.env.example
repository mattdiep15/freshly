# Copy to web/.env.local. `npx convex dev` writes these for you on first run;
# for a fresh local setup run: CONVEX_AGENT_MODE=anonymous npx convex dev --once
CONVEX_DEPLOYMENT=anonymous:anonymous-agent
NEXT_PUBLIC_CONVEX_URL=http://127.0.0.1:3210
NEXT_PUBLIC_CONVEX_SITE_URL=http://127.0.0.1:3211

# Not set here: these live on the Convex deployment (`npx convex env set NAME value`).
#   JWT_PRIVATE_KEY, JWKS, SITE_URL  -> generated by `npx @convex-dev/auth`
#   ALLOW_DEMO_USER=true             -> dev deployments only, never production
